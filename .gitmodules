[submodule "third_party/SDL"]
	path = third_party/SDL
	url = https://github.com/libsdl-org/SDL
[submodule "third_party/quickjs"]
	path = third_party/quickjs
	url = https://github.com/AserJoker/quickjs.git
[submodule "third_party/SDL_net"]
	path = third_party/SDL_net
	url = https://github.com/libsdl-org/SDL_net
[submodule "third_party/cJSON"]
	path = third_party/cJSON
	url = https://github.com/DaveGamble/cJSON
[submodule "third_party/googletest"]
	path = third_party/googletest
	url = https://github.com/google/googletest.git
[submodule "third_party/SDL_image"]
	path = third_party/SDL_image
	url = https://github.com/libsdl-org/SDL_image
	branch = main
[submodule "third_party/SDL_ttf"]
	path = third_party/SDL_ttf
	url = https://github.com/libsdl-org/SDL_ttf
	branch = main
[submodule "third_party/glm"]
	path = third_party/glm
	url = https://github.com/g-truc/glm
