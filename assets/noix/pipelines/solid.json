{
  "vertex_shader": "noix:shaders/solid/tri_color.spv",
  "fragment_shader": "noix:shaders/solid/color.spv",
  "primitive_type": "triangle_list",
  "vertex_input": {
    "buffers": [
      { "slot": 0, "stride": 24, "input_rate": "vertex" }
    ],
    "attributes": [
      { "location": 0, "buffer_slot": 0, "format": "float2", "offset": 0 },
      { "location": 1, "buffer_slot": 0, "format": "float4", "offset": 8 }
    ]
  },
  "rasterizer": {
    "fill_mode": "fill",
    "cull_mode": "none",
    "front_face": "counter_clockwise"
  },
  "color_targets": [
    {
      "format": "swapchain",
      "blend": {
        "src_color": "src_alpha",
        "dst_color": "one_minus_src_alpha",
        "color_op": "add",
        "src_alpha": "one",
        "dst_alpha": "one_minus_src_alpha",
        "alpha_op": "add"
      }
    }
  ],
  "multisample": { "sample_count": 1 }
}
